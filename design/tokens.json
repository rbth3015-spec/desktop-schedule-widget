{
  "$comment": "일정관리 비서 디자인 토큰 — PC 위젯과 폰 앱이 함께 쓰는 단 하나의 원본. 값을 바꿀 때는 이 파일만 고치고 `npm run tokens` 로 design/build/ 를 다시 만든다. `npm test` 가 이 값과 PC 위젯 CSS 가 같은지 잰다.",
  "meta": {
    "name": "일정관리 비서",
    "version": 1,
    "source": "Claude Design 핸드오프 tokens.css(라이트) + src/renderer/styles/base.css(다크 · 보조색)",
    "androidPackage": "com.dongik.schedule.design",
    "unit": "1 CSS px = 1 dp(크기) · 1 sp(글자)"
  },

  "color": {
    "paper":         { "light": "#f5f2ec", "dark": "#22201d", "use": "바탕 — 종이" },
    "paper-2":       { "light": "#efebe3", "dark": "#2a2723", "use": "칸 · 비활성 탭" },
    "paper-3":       { "light": "#e6e1d6", "dark": "#33302a", "use": "누름 · hover · 설정 탭" },
    "ink":           { "light": "#22201d", "dark": "#ece5d7", "use": "본문 글자" },
    "ink-soft":      { "light": "#5d5951", "dark": "#a9a294", "use": "보조 글자 · 토요일" },
    "ink-faint":     { "light": "#98928a", "dark": "#6f6a60", "use": "흐린 글자 · 지난 것" },
    "rule":          { "light": { "ref": "ink", "alpha": 0.15 }, "dark": { "ref": "ink", "alpha": 0.15 }, "use": "괘선 — 면은 색이 아니라 1px 선으로 나눈다" },
    "rule-soft":     { "light": { "ref": "ink", "alpha": 0.08 }, "dark": { "ref": "ink", "alpha": 0.08 }, "use": "옅은 괘선 · 줄 사이" },
    "edge":          { "light": { "ref": "ink", "alpha": 0.22 }, "dark": { "ref": "ink", "alpha": 0.22 }, "use": "입력칸 테두리" },
    "border-strong": { "light": { "ref": "ink", "alpha": 0.30 }, "dark": { "ref": "ink", "alpha": 0.30 }, "use": "강한 테두리" },
    "gold":          { "light": "#b68235", "dark": "#c9a05a", "use": "강조 · 포커스 · 진행 막대" },
    "gold-deep":     { "light": "#7d5411", "dark": "#dcbc80", "use": "금박 글자(다가올 시각) — 다크에서는 gold 보다 밝다" },
    "gold-ghost":    { "light": { "ref": "gold", "alpha": 0.14 }, "dark": { "ref": "gold", "alpha": 0.16 }, "use": "선택 영역" },
    "seal":          { "light": "#8d3a2c", "dark": "#c0705c", "use": "인주 — 오늘 · 일요일 · 삭제" },
    "accent-soft":   { "light": { "ref": "seal", "alpha": 0.10 }, "dark": { "ref": "seal", "alpha": 0.16 }, "use": "인주 옅게" },
    "accent-wash":   { "light": { "ref": "seal", "alpha": 0.04 }, "dark": { "ref": "seal", "alpha": 0.08 }, "use": "인주 아주 옅게" },
    "success":       { "light": "#5c6b4a", "dark": "#8ea173", "use": "루틴 ↻ · 성공" },
    "on-color":      { "light": "#f4ede1", "dark": "#f4ede1", "use": "항목 색 위 글자" },
    "cover":         { "light": "#3a332b", "dark": "#17150f", "use": "표지 — 폰에서는 위 머리 막대" },
    "cover-ink":     { "light": "#d6c4a0", "dark": "#d6c4a0", "use": "표지 위 글자 · 아이콘" },
    "cover-ink-hi":  { "light": "#e8dcc2", "dark": "#e8dcc2", "use": "표지 위 글자 hover" },
    "ribbon-lo":     { "light": "#752f24", "dark": "#752f24", "use": "리본 책갈피 아래" },
    "ribbon-hi":     { "light": "#8d3a2c", "dark": "#8d3a2c", "use": "리본 책갈피 위" },
    "dock":          { "light": "#f0ece4", "dark": "#2a2723", "use": "아래 리본(D-Day)" },
    "desk":          { "light": "#4a443c", "dark": "#4a443c", "use": "바깥 바탕(PC 위젯은 투명)" }
  },

  "item": {
    "$comment": "항목 색 6종 — 키는 동기화 데이터의 color 값 그대로. 두 테마 같은 값. 모르는 키는 blue. 시간 블록 = 이 색 20% 를 paper 에 섞은 바탕 + 왼쪽 3px 선.",
    "blue":   { "value": "#4a5f7a", "label": "청람", "css": "--blue" },
    "green":  { "value": "#5c6b4a", "label": "쑥",   "css": "--moss" },
    "amber":  { "value": "#9a7a2e", "label": "치자", "css": "--citron" },
    "rose":   { "value": "#9c4a33", "label": "다홍", "css": "--vermilion" },
    "violet": { "value": "#6d4a5e", "label": "자주", "css": "--plum" },
    "slate":  { "value": "#4f4b45", "label": "회묵", "css": "--charcoal" }
  },

  "font": {
    "$comment": "세 가지뿐 — 앱에 묶어 넣는다(시스템 글꼴 폴백 금지). 모두 SIL OFL 1.1. 굵기는 최대 500.",
    "serif": { "family": ["Noto Serif KR", "Cormorant Garamond", "serif"], "weights": [200, 300, 400, 500], "use": "날짜 · 화면 제목 · 표제 · 탭 이름" },
    "sans":  { "family": ["Noto Sans KR", "system-ui", "sans-serif"], "weights": [300, 400, 500], "use": "본문 · 버튼 · 칩" },
    "num":   { "family": ["Cormorant Garamond", "Noto Serif KR", "serif"], "weights": [300, 400, 500], "features": ["tnum"], "use": "모든 숫자 — 자릿수 맞춤" },
    "maxWeight": 500
  },

  "size": {
    "$comment": "글자 크기(px). from = 이 값을 쓰는 PC 위젯 CSS 자리 — 시험이 그 자리의 값과 같은지 잰다.",
    "title":      { "px": 20,   "use": "화면 제목 · 날짜 머리(9월 30일)", "from": ["src/renderer/todo/todo.css", ".todo-head__day", "font-size"] },
    "body":       { "px": 13,   "use": "본문 기본",                       "from": ["src/renderer/styles/base.css", null, "--fs"] },
    "coverTitle": { "px": 13,   "use": "표지 제목 '일정관리 비서'",       "from": ["src/renderer/styles/base.css", ".titlebar__title", "font-size"] },
    "aide":       { "px": 12.5, "use": "비서의 한 줄",                    "from": ["src/renderer/todo/todo.css", ".todo-aide__text", "font-size"] },
    "label":      { "px": 12,   "use": "요일 · 보조 머리",                "from": ["src/renderer/todo/todo.css", ".todo-head__week", "font-size"] },
    "tab":        { "px": 11,   "use": "책갈피 탭 · 달력 요일 머리",       "from": ["src/renderer/styles/base.css", ".tab", "font-size"] },
    "chip":       { "px": 10.5, "use": "시각 칩(14:00)",                  "from": ["src/renderer/todo/todos.css", ".tds-item__when", "font-size"] },
    "badge":      { "px": 9.5,  "use": "'오늘' 같은 작은 표",             "from": ["src/renderer/todo/todo.css", ".todo-head__today", "font-size"] }
  },

  "tracking": {
    "$comment": "자간(em).",
    "coverTitle": { "em": 0.34, "from": ["src/renderer/styles/base.css", ".titlebar__title", "letter-spacing"] },
    "tab":        { "em": 0.22, "from": ["src/renderer/styles/base.css", ".tab", "letter-spacing"] },
    "weekday":    { "em": 0.22, "from": ["src/renderer/calendar/calendar.css", ".cal-weekday", "letter-spacing"] },
    "label":      { "em": 0.16, "from": ["src/renderer/todo/todo.css", ".todo-head__week", "letter-spacing"] },
    "badge":      { "em": 0.1,  "from": ["src/renderer/todo/todo.css", ".todo-head__today", "letter-spacing"] }
  },

  "lineHeight": {
    "aide": { "ratio": 1.75, "from": ["src/renderer/todo/todo.css", ".todo-aide__text", "line-height"] }
  },

  "radius": {
    "$comment": "모서리(px) — 칩 · 블록 1 / 버튼 · 입력 · 카드 2 / 면 3 / 표지 5. 이보다 둥글게 하지 않는다.",
    "chip":    { "px": 1, "css": "--radius-chip" },
    "control": { "px": 2, "css": "--radius-sm" },
    "pane":    { "px": 3, "css": "--radius" },
    "cover":   { "px": 5, "css": "--radius-cover" }
  },

  "border": {
    "$comment": "선 굵기(px).",
    "hairline": { "px": 1, "use": "괘선 · 버튼 윤곽 — 버튼은 채우지 않고 이 선만" },
    "accent":   { "px": 2, "use": "비서의 한 줄 왼쪽 금박 선 · 진행 막대 · 포커스" },
    "item":     { "px": 3, "use": "시간 블록 · 상세 머리의 왼쪽 항목색 선" }
  },

  "shadow": {
    "$comment": "그림자는 이 4종뿐. y · blur(px), alpha(검정). cover 는 cover-ink 1px 안쪽 테두리를 더한다.",
    "cover": { "y": 30, "blur": 70, "alpha": 0.5, "ring": { "ref": "cover-ink", "alpha": 0.18 } },
    "modal": { "y": 20, "blur": 48, "alpha": 0.34 },
    "peek":  { "y": 18, "blur": 42, "alpha": 0.32 },
    "tab":   { "y": 2,  "blur": 5,  "alpha": 0.28 }
  },

  "opacity": {
    "outsideMonth": { "value": 0.45, "use": "이번 달 밖 날짜 · 끝난 기간 막대" },
    "pastBlock":    { "value": 0.55, "use": "지난 시간 블록" },
    "blockTint":    { "value": 0.20, "use": "시간 블록 바탕 = 항목색을 paper 에 이만큼" }
  },

  "scrim": { "hex": "#22201d", "alpha": 0.34, "use": "peek · 모달 뒤를 덮는 막" },

  "motion": {
    "$comment": "들어올 때만 움직인다. 가만히 있을 때 도는 애니메이션은 없다.",
    "leafIn":  { "ms": 500, "easing": "ease", "fromOpacity": 0, "translateY": 7,  "use": "펼침면이 열릴 때" },
    "pageIn":  { "ms": 280, "easing": "ease", "fromOpacity": 0, "translateX": 10, "use": "탭으로 화면을 바꿀 때" },
    "scrimIn": { "ms": 220, "easing": "ease", "fromOpacity": 0, "use": "막이 깔릴 때" }
  },

  "focus": { "width": 2, "offset": 2, "color": "gold", "use": "포커스 링 — 기본 파란 링 대신" },

  "icon": { "stroke": 1.5, "strokeMin": 1.4, "strokeMax": 1.6, "sizeMin": 11, "sizeMax": 14, "use": "선 아이콘(Lucide 계열). 폰은 48dp 터치 영역 안에 16–18dp" },

  "todayMark": { "width": 17, "height": 1, "color": "seal", "use": "오늘 = 날짜 숫자 아래 밑줄(채운 원이 아니다)" }
}
